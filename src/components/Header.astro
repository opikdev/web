---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Work', href: '/work' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];

const path = Astro.url.pathname;
---

<header class="mx-auto w-full max-w-shell px-6 pt-8 sm:pt-10">
  <div
    class="flex flex-col gap-4 border-b border-border pb-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:pb-4.5"
  >
    <div>
      <a href="/" class="inline-block" aria-label="Opik, home">
        <Logo class="h-5 w-auto" />
      </a>
      <p class="mt-1.5 text-xs text-text-3">
        Full-stack engineer &nbsp;·&nbsp; Technical lead &nbsp;·&nbsp; AI integration
      </p>
    </div>

    <div class="flex items-center justify-between gap-5 sm:justify-end sm:gap-6">
      <nav aria-label="Main">
        <ul class="flex items-center gap-5">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path.startsWith(item.href) ? 'page' : undefined}
                  class="text-sm text-text-2 transition-colors hover:text-text-1 aria-[current=page]:text-text-1"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-3 sm:gap-6">
        <ThemeToggle />

        <a
          href="/hire"
          class="rounded-pill bg-accent px-4 py-2 text-sm font-medium whitespace-nowrap text-accent-ink transition-opacity hover:opacity-90"
        >
          Hire me
        </a>
      </div>
    </div>
  </div>
</header>
