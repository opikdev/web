---
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import { work } from '../data/work.ts';
---

<section class="pt-10.5">
  <SectionHeader title="Selected work" linkLabel="View all" linkHref="/work">
    <div slot="actions" class="flex items-center gap-1.5">
      <button
        type="button"
        data-scroll="-1"
        class="grid size-7 place-items-center rounded-pill border border-border text-text-3 transition-colors hover:text-text-1 disabled:cursor-default disabled:opacity-40 disabled:hover:text-text-3"
        aria-label="Previous work"
        disabled
      >
        <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>
      <button
        type="button"
        data-scroll="1"
        class="grid size-7 place-items-center rounded-pill border border-border text-text-3 transition-colors hover:text-text-1 disabled:cursor-default disabled:opacity-40 disabled:hover:text-text-3"
        aria-label="Next work"
        disabled
      >
        <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
    </div>
  </SectionHeader>

  <ul
    id="work-track"
    class="flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      work.map((item) => (
        <li class="w-[292px] shrink-0 snap-start">
          <a
            href={item.href}
            class="group flex h-full flex-col rounded-card bg-surface p-2.5 transition-colors hover:bg-thumb"
            {...(item.href.startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}
            {...(item.href === '#' ? { 'aria-disabled': 'true', tabindex: -1 } : {})}
          >
            {item.cover ? (
              <Image
                src={item.cover}
                alt={`${item.title} palette`}
                width={584}
                height={304}
                loading="lazy"
                class="h-38 w-full rounded-[9px] object-cover"
              />
            ) : (
              <div class="grid h-38 w-full place-items-center gap-3 rounded-[9px] bg-thumb text-text-3">
                <svg viewBox="0 0 28 18" class="size-8 opacity-55" fill="currentColor" aria-hidden="true">
                  <path d="M0 9c0-4.97056 4.02944-9 9-9l0 4-0.25684 0.00684c-2.64206 0.13369-4.74316 2.31788-4.74316 4.99316 0 2.76142 2.23858 5 5 5l10 0c2.76142 0 5-2.23858 5-5 0-2.67528-2.10111-4.85947-4.74316-4.99316l-0.25684-0.00684 0-4c4.97056 0 9 4.02944 9 9 0 4.97056-4.02944 9-9 9l-10 0c-4.97056 0-9-4.02944-9-9z m19-9l0 4-10 0 0-4 10 0z" />
                </svg>
                <span class="text-xs">{item.title}</span>
              </div>
            )}

            <div class="px-1 pt-2.5 pb-1">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-medium text-text-1">{item.title}</h3>
                {item.kind && <span class="text-xs text-text-3">{item.kind}</span>}
                {item.status && (
                  <span class="rounded-pill border border-border px-2.5 py-0.5 text-xs text-text-3">
                    {item.status}
                  </span>
                )}
              </div>
              <p class="mt-1 text-xs leading-[1.45] text-text-3">{item.description}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const track = document.getElementById('work-track');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-scroll]');

  if (track) {
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      buttons.forEach((button) => {
        const back = Number(button.dataset.scroll) < 0;
        button.disabled = max <= 0 || (back ? track.scrollLeft <= 1 : track.scrollLeft >= max - 1);
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        track.scrollBy({ left: Number(button.dataset.scroll) * 312, behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(track);
    sync();
  }
</script>
