---

<footer class="mx-auto w-full max-w-site px-6 pb-14 pt-24">
  <div class="flex items-center justify-between gap-6">
    <p class="text-xs text-text-3">© {year} Opik</p>

    <ul class="flex items-center gap-4">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              rel="noopener me"
              target="_blank"
              class="block text-text-3 transition-colors hover:text-text-1"
              aria-label={s.label}
            >
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                <path d={s.d} />
              </svg>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="mailto:hi@opik.dev"
          class="block text-text-3 transition-colors hover:text-text-1"
          aria-label="Email"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
            <path d="M6.682 3.5H17.182A4 4 0 0 1 21.182 7.5V16.5A4 4 0 0 1 17.182 20.5H6.682A4 4 0 0 1 2.682 16.5V7.5A4 4 0 0 1 6.682 3.5Z"></path>
            <path stroke-linecap="round" d="m2.729 7.59l7.205 4.13a3.96 3.96 0 0 0 3.975 0l7.225-4.13"></path>
          </svg>
        </a>
